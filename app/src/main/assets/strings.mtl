# ==================== Google Cloud Translation (gc_) ====================
gc_plugin_name: Google Cloud Translate

gc_pref_header_main: Google Cloud Translation
gc_pref_plugin_name: Plugin Name
gc_pref_plugin_description: Advanced translation using Google's Neural Machine Translation

gc_pref_header_api_config: API Configuration
